<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 在线云端版无需本机后台保活、开机自启或离线同步权限，显式剔除防止 Google Play 权限拒审。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="remove" />

    <application
        android:name=".cloud.CloudApp"
        android:label="@string/app_name"
        tools:replace="android:name">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="${admobDelayAppMeasurementInit}" />

        <activity android:name=".MainActivity" tools:node="remove" />
        <activity android:name=".share.ShareReceiverActivity" tools:node="remove" />
        <activity android:name=".web.PlatformWebActivity" tools:node="remove" />
        <service android:name="androidx.work.impl.foreground.SystemForegroundService" tools:node="remove" />
        <service android:name="androidx.room.MultiInstanceInvalidationService" tools:node="remove" />
        <receiver android:name=".sync.BootCompletedReceiver" tools:node="remove" />

        <activity
            android:name=".cloud.CloudMainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FitSync.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="fitsync-cloud"
                    android:host="oauth" />
            </intent-filter>
        </activity>

        <activity
            android:name=".cloud.CloudShareReceiverActivity"
            android:exported="true"
            android:label="@string/share_receiver_label"
            android:theme="@style/Theme.FitSync">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/vnd.ant.fit" />
                <data android:mimeType="application/fit" />
                <data android:mimeType="application/zip" />
                <data android:pathPattern=".*\\.fit" />
                <data android:pathPattern=".*\\.FIT" />
                <data android:pathPattern=".*\\.zip" />
                <data android:pathPattern=".*\\.ZIP" />
            </intent-filter>
        </activity>
    </application>
</manifest>
