{
  "manifest_version": 3,
  "name": "FitSync 会话助手",
  "version": "0.1.0",
  "description": "在你本人登录运动平台后，把该平台的网页会话提交给指定的 FitSync 云服务。",
  "permissions": ["cookies", "storage", "scripting", "tabs", "windows"],
  "host_permissions": [
    "https://www.strava.com/*",
    "https://*.strava.com/*",
    "https://connect.garmin.cn/*",
    "https://sso.garmin.cn/*",
    "https://otm.onelap.cn/*",
    "https://*.onelap.cn/*",
    "https://www.imxingzhe.com/*"
  ],
  "optional_host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*/*"],
  "externally_connectable": {
    "matches": ["http://127.0.0.1/*", "http://localhost/*", "https://*/*"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "连接 FitSync",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": { "service_worker": "bridge.js" },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
